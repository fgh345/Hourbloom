# Godot 4+ specific ignores
.godot/
/android/
**/*.lnk

# Addons policy:
# - Track source/config/resources for reproducibility
# - Ignore heavy native binaries/build artifacts

# Keep source by default
!addons/**/

# Ignore common heavy/binary artifact types inside addons
addons/**/*.dll
addons/**/*.so
addons/**/*.dylib
addons/**/*.a
addons/**/*.lib
addons/**/*.pdb
addons/**/*.obj
addons/**/*.o
addons/**/*.exe
addons/**/*.bin
addons/**/*.bc
addons/**/*.zip
addons/**/*.7z

# Ignore native/build output folders often shipped with addons
addons/**/android/
addons/**/ios/
addons/**/linux/
addons/**/macos/
addons/**/windows/
addons/**/native/
addons/**/build/
addons/**/bin/
addons/**/.build/

# Terrain3D needs native libraries to load its classes on Linux.
!addons/terrain_3d/bin/
!addons/terrain_3d/bin/libterrain.linux.debug.x86_64.so
!addons/terrain_3d/bin/libterrain.linux.release.x86_64.so

# Explicitly keep common addon source/config/resources
!addons/**/*.gd
!addons/**/*.gdshader
!addons/**/*.gdextension
!addons/**/*.cfg
!addons/**/*.tres
!addons/**/*.res
!addons/**/README.md
!addons/**/LICENSE*

Assets/*.png

# Track Godot sidecars. They preserve resource identities and import settings
# across clean clones; generated import artifacts remain under ignored .godot/.

**/exported
.export-to-txt.*
/addons/godot_mcp_toolkit
